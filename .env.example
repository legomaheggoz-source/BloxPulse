# BloxPulse Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# HuggingFace Configuration (Required for deployment)
# =============================================================================
HF_TOKEN=your_huggingface_token_here
HF_SPACE_NAME=bloxpulse
HF_DATASET_NAME=bloxpulse-data

# =============================================================================
# API Keys (Optional - for Phase 2)
# =============================================================================
# YouTube Data API v3 (free tier: 10,000 quota units/day)
YOUTUBE_API_KEY=

# X/Twitter API (free tier: 300,000 tweets/month)
TWITTER_BEARER_TOKEN=

# =============================================================================
# Application Configuration
# =============================================================================
# Environment: development, production
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=7860

# Database (SQLite path relative to backend/)
DATABASE_URL=sqlite:///./bloxpulse.db

# =============================================================================
# Data Collection Settings
# =============================================================================
# How often to collect data (in hours)
COLLECTION_INTERVAL_HOURS=6

# How often to sync to HuggingFace Dataset (in hours)
SYNC_INTERVAL_HOURS=6

# =============================================================================
# Cache Settings
# =============================================================================
# Cache TTL in seconds (default: 24 hours)
CACHE_TTL_SECONDS=86400

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
